[Unit]
Description=Service to keep the actions runner running
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ci-runner
WorkingDirectory=/home/ci-runner/actions-runner
ExecStart=/bin/bash /home/ci-runner/actions-runner/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target