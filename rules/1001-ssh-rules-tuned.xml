<!-- Syscheck (FIM) custom rules -->
<group name="ossec,syscheck,">

  <!-- Alert level 10 for any file modification in /usr/local/bin -->
  <!-- Triggers on: file added, modified, or deleted in /usr/local/bin -->
  <!-- Parent rule 550 = integrity checksum changed (default level 7) -->
  <!-- Parent rule 554 = file added to the system -->
  <!-- Parent rule 553 = file deleted from the system -->

  <rule id="100011" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="syscheck.path">/usr/local/bin/wazuh-deploy.sh</field>
    <description>FIM: File integrity change detected in /usr/local/bin</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>syscheck,syscheck_entry_modified,local_syscheck_critical,extended_rule, </group>
  </rule>

</group>